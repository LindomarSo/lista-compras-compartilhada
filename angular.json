{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "lista-junto": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "index.html",
            "tsConfig": "tsconfig.json",
            "baseHref": "./",
            "outputPath": { "base": "dist", "browser": "" },
            "styles": ["src/styles.scss"],
            "allowedCommonJsDependencies": ["tesseract.js", "regenerator-runtime/runtime"],
            "assets": [
              { "glob": "**/*", "input": "icons", "output": "icons" },
              { "glob": "manifest.webmanifest", "input": ".", "output": "." },
              { "glob": "privacidade.html", "input": ".", "output": "." },
              { "glob": "privacy.css", "input": "src", "output": "." },
              { "glob": "worker.min.js", "input": "node_modules/tesseract.js/dist", "output": "ocr" },
              { "glob": "*-lstm.wasm.js", "input": "node_modules/tesseract.js-core", "output": "ocr" },
              { "glob": "por.traineddata.gz", "input": "node_modules/@tesseract.js-data/por/4.0.0_best_int", "output": "ocr" },
              { "glob": "LICENSE.md", "input": "node_modules/tesseract.js", "output": "ocr/tesseract" },
              { "glob": "LICENSE", "input": "node_modules/tesseract.js-core", "output": "ocr/core" }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "lista-junto:build:development" }
        }
      }
    }
  }
}
