{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": { "files": ["/index.html", "/*.js", "/*.css", "/manifest.webmanifest", "/icons/**", "/privacidade.html", "!/ngsw-worker.js", "!/safety-worker.js", "!/worker-basic.min.js"] }
    },
    {
      "name": "ocr",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": { "files": ["/ocr/**"] }
    }
  ]
}
