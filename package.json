{
  "name": "lista-junto",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "ng serve",
    "build": "npm run tokens:check && ng build && node scripts/service-worker.mjs",
    "tokens:check": "node scripts/theme-colors.mjs --check",
